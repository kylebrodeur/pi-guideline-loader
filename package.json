{
  "name": "pi-guideline-loader",
  "version": "0.1.3",
  "description": "Automatically loads CLAUDE.md and AGENTS.md guidelines based on CWD and session interaction history for pi agent.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "keywords": [
    "pi",
    "pi-extension",
    "ai-agent",
    "llm",
    "context-management",
    "monorepo",
    "guidelines",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylebrodeur/pi-guideline-loader.git"
  },
  "bugs": {
    "url": "https://github.com/kylebrodeur/pi-guideline-loader/issues"
  },
  "homepage": "https://github.com/kylebrodeur/pi-guideline-loader",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@types/node": "^20.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module"
}
